--UPDATE tpex_bulletin_attention  SET law_src = '第六款' WHERE id = 17487;</sql><sql name="Execute">UPDATE tpex_bulletin_attention SET law_src = NULL;</sql><current_tab id="1"/></tab_sql></sqlb_project>
