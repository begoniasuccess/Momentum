<sort><column index="2" mode="0"/></sort><column_widths><column index="1" value="62"/><column index="2" value="110"/><column index="3" value="78"/><column index="4" value="102"/><column index="5" value="96"/><column index="6" value="47"/><column index="7" value="47"/><column index="8" value="47"/><column index="9" value="47"/><column index="10" value="47"/><column index="11" value="107"/><column index="12" value="87"/><column index="13" value="87"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="ml_law1_t1_long" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="65"/><column index="2" value="39"/><column index="3" value="58"/><column index="4" value="87"/><column index="5" value="151"/><column index="6" value="91"/><column index="7" value="64"/><column index="8" value="94"/><column index="9" value="77"/><column index="10" value="91"/><column index="11" value="175"/><column index="12" value="74"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="ml_law1_t1_short" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="65"/><column index="2" value="39"/><column index="3" value="58"/><column index="4" value="87"/><column index="5" value="151"/><column index="6" value="91"/><column index="7" value="64"/><column index="8" value="94"/><column index="9" value="77"/><column index="10" value="91"/><column index="11" value="175"/><column index="12" value="77"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="tpex_bulletin_attention" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="5" mode="1"/></sort><column_widths><column index="1" value="39"/><column index="2" value="60"/><column index="3" value="117"/><column index="4" value="34"/><column index="5" value="300"/><column index="6" value="79"/><column index="7" value="55"/><column index="8" value="63"/><column index="9" value="300"/><column index="10" value="159"/><column index="11" value="87"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="v_law1_feature_ana" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="3" mode="0"/></sort><column_widths><column index="1" value="65"/><column index="2" value="39"/><column index="3" value="60"/><column index="4" value="58"/><column index="5" value="101"/><column index="6" value="67"/><column index="7" value="151"/><column index="8" value="165"/><column index="9" value="91"/><column index="10" value="94"/><column index="11" value="77"/><column index="12" value="91"/><column index="13" value="73"/><column index="14" value="64"/><column index="15" value="74"/><column index="16" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="v_law1_feature_ana_t1_long" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="65"/><column index="2" value="39"/><column index="3" value="60"/><column index="4" value="58"/><column index="5" value="87"/><column index="6" value="50"/><column index="7" value="151"/><column index="8" value="165"/><column index="9" value="91"/><column index="10" value="94"/><column index="11" value="77"/><column index="12" value="91"/><column index="13" value="73"/><column index="14" value="64"/><column index="15" value="74"/><column index="16" value="300"/><column index="17" value="57"/><column index="18" value="58"/><column index="19" value="55"/><column index="20" value="55"/><column index="21" value="112"/><column index="22" value="84"/><column index="23" value="175"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="v_law1_feature_ana_t1_short" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="22" mode="1"/></sort><column_widths><column index="1" value="65"/><column index="2" value="39"/><column index="3" value="60"/><column index="4" value="58"/><column index="5" value="87"/><column index="6" value="50"/><column index="7" value="151"/><column index="8" value="165"/><column index="9" value="91"/><column index="10" value="94"/><column index="11" value="77"/><column index="12" value="91"/><column index="13" value="73"/><column index="14" value="64"/><column index="15" value="74"/><column index="16" value="300"/><column index="17" value="57"/><column index="18" value="58"/><column index="19" value="55"/><column index="20" value="55"/><column index="21" value="128"/><column index="22" value="96"/><column index="23" value="175"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="History">SELECT * FROM twse_announcement_notice 
	WHERE id+0 = (SELECT notice_id+0 FROM notice_behavior_feature WHERE id+0 = 155);


-- Check notice_behavior_feature.law1_consecutive_days 欄位
SELECT strftime('%Y-%m-%d', F.notice_dt_ts, 'unixepoch') AS F_dt, 
	strftime('%Y-%m-%d', N.公告日期_ts, 'unixepoch') AS date,
	F.law1_consecutive_days, F.law_src, N.* 
	FROM tpex_bulletin_attention N
	LEFT JOIN notice_behavior_feature F ON F.id+0 = 39441
		WHERE N.證券代號 = F.stock_no
			AND N.公告日期_ts+0 &lt;= F.notice_dt_ts
			AND law_src LIKE '%第一款%'
	ORDER BY N.證券代號, 公告日期 DESC;
	
SELECT strftime('%Y-%m-%d', F.notice_dt_ts, 'unixepoch') AS F_dt, 
	strftime('%Y-%m-%d', N.日期_ts, 'unixepoch') AS date,
	F.law1_consecutive_days, F.law_src, N.* 
	FROM twse_announcement_notice N
	LEFT JOIN notice_behavior_feature F ON F.id+0 = 22394
		WHERE N.證券代號 = F.stock_no
			AND N.日期_ts+0 &lt;= F.notice_dt_ts
			AND law_src LIKE '%第一款%'
	ORDER BY N.證券代號, N.日期 DESC;
	
	

SELECT strftime('%Y.%m.%d', F.notice_dt_ts, 'unixepoch') AS F_dt, F.* 
	FROM notice_behavior_feature F WHERE id+0 = 13718;

SELECT strftime('%Y-%m-%d', N.notice_dt_ts, 'unixepoch') AS notice_date, N.* 
	FROM notice_behavior_feature N
	WHERE law_src LIKE '%第一款%'
	ORDER BY type, stock_no, notice_dt_ts DESC;
	
	
SELECT id, type, notice_id, stock_no, strftime('%Y-%m-%d', notice_dt_ts, 'unixepoch', 'localtime') AS notice_date
	, notice_dt_ts, law_src	,law1_consecutive_days	
	FROM notice_behavior_feature
	WHERE law_src LIKE '%第一款%'
	ORDER BY type, stock_no, notice_dt_ts DESC;
	
SELECT count(*) as cnt	
	FROM notice_behavior_feature
	WHERE law_src LIKE '%第一款%' AND law1_consecutive_days iS NULL;
	
SELECT count(*) as cnt	
	FROM notice_behavior_feature
	WHERE law_src LIKE '%第一款%' AND law1_consecutive_days iS NOT NULL;

UPDATE notice_behavior_feature
SET pred_prob_disposal = NULL;


UPDATE notice_behavior_feature SET will_be_disposed_tomorrow = 0 WHERE will_be_disposed_tomorrow IS NULL;

SELECT * FROM law_feature_base WHERE law_src = '第一款' 
	--AND target_table = 'twse_announcement_notice'
	ORDER BY target_table, target_id;
	
UPDATE law_feature_base
SET threshold_value = 50
WHERE target_table = 'twse_announcement_notice'
  AND law_src = '第一款'
  AND feature_key = 'price_diff'
  AND threshold_value IS NULL;
  	
DROP VIEW IF EXISTS v_law1_feature_ana;

CREATE VIEW v_law1_feature_ana AS
WITH base_twse AS (
    SELECT
        target_id,
        law_src,
        feature_key,
        feature_value,
        threshold_value,
        raw_text
    FROM law_feature_base
    WHERE target_table = 'twse_announcement_notice'
      AND law_src = '第一款'
),
base_tpex AS (
    SELECT
        target_id,
        law_src,
        feature_key,
        feature_value,
        threshold_value,
        raw_text
    FROM law_feature_base
    WHERE target_table = 'tpex_bulletin_attention'
      AND law_src = '第一款'
),
base_union AS (
    -- TWSE / TPEX 第一款 合併
    SELECT * FROM base_twse
    UNION ALL
    SELECT * FROM base_tpex
),
acc_return AS (
    SELECT
        target_id,
        feature_value   AS acc_return_pct,
        threshold_value AS a_threshold
    FROM base_union
    WHERE feature_key = 'acc_return_pct'
),
price_diff AS (
    SELECT
        target_id,
        feature_value   AS price_diff,
        threshold_value AS p_threshold
    FROM base_union
    WHERE feature_key = 'price_diff'
),
raw_text AS (
    SELECT
        target_id,
        law_src,
        raw_text AS notice_raw_content
    FROM base_union
    GROUP BY target_id
)

SELECT
    F.id AS feature_id,
    F.type,
    F.notice_id,
    F.stock_no,
    strftime('%Y-%m-%d', F.notice_dt_ts, 'unixepoch', 'localtime') AS notice_date,

    -- ⚠ law_src 改用 B 端（永遠是 '第一款'）
    R.law_src,

    F.will_be_disposed_tomorrow,
    A.acc_return_pct,
    A.a_threshold,
    P.price_diff,
    P.p_threshold,
    R.notice_raw_content

FROM notice_behavior_feature F
LEFT JOIN acc_return A
    ON A.target_id = F.notice_id
LEFT JOIN price_diff P
    ON P.target_id = F.notice_id
LEFT JOIN raw_text R
    ON R.target_id = F.notice_id

WHERE
    F.any_rule_one_day_away = 1
    AND F.rule_one_day_away_count = 1
    -- 再鎖一次，只保留第一款
    AND R.law_src = '第一款'

ORDER BY
	F.type,
    F.stock_no,
    F.notice_dt_ts DESC;
	</sql><sql name="Execute">-- ① 建新表（完全正確欄位，所有 rule/label/pred 一律預設 NULL）

CREATE TABLE notice_behavior_feature_new (
	&quot;id&quot;	INTEGER,
	&quot;type&quot;	TEXT NOT NULL,
	&quot;notice_id&quot;	INTEGER NOT NULL,
	&quot;stock_no&quot;	TEXT NOT NULL,
	&quot;notice_dt_ts&quot;	INTEGER,
	&quot;law_src&quot;	TEXT,
	&quot;coming_punish_id&quot;	INTEGER,
	&quot;coming_punish_interval_days&quot;	INTEGER,
	&quot;days_to_next_notice&quot;	INTEGER,
	&quot;notice_law_count&quot;	INTEGER,
	&quot;same_law_repeat_3t&quot;	INTEGER,
	&quot;law1_consecutive_days&quot;	INTEGER,
	&quot;law1to8_count_10t&quot;	INTEGER,
	&quot;law1to8_count_30t&quot;	INTEGER,
	&quot;law1to8_consecutive_days&quot;	INTEGER,

	&quot;disposal_period_day_index&quot;	INTEGER,
	&quot;disposal_period&quot;	INTEGER,
	&quot;disposal_times_30t&quot;	INTEGER,

	-- Rule-based flags (全部 NULL)
	&quot;rule1_one_day_away&quot; INTEGER,
	&quot;rule2_one_day_away&quot; INTEGER,
	&quot;rule3_one_day_away&quot; INTEGER,
	&quot;rule4_one_day_away&quot; INTEGER,
	&quot;any_rule_one_day_away&quot; INTEGER,

	-- Label（全部 NULL）
	&quot;will_be_disposed_tomorrow&quot; INTEGER,

	-- Model Prediction（NULL）
	&quot;pred_prob_disposal&quot; REAL,

	&quot;created_at&quot;	TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
	PRIMARY KEY(&quot;id&quot; AUTOINCREMENT)
);

-- ② 複製舊資料 → 所有新欄位保持 NULL（不填 0！）

INSERT INTO notice_behavior_feature_new (
	id, type, notice_id, stock_no, notice_dt_ts, law_src,
	coming_punish_id, coming_punish_interval_days, days_to_next_notice,
	notice_law_count, same_law_repeat_3t, law1_consecutive_days,
	&quot;law1to8_count_10t&quot;, &quot;law1to8_count_30t&quot;, &quot;law1to8_consecutive_days&quot;,
	disposal_period_day_index, disposal_period, disposal_times_30t,

	rule1_one_day_away, rule2_one_day_away, rule3_one_day_away,
	rule4_one_day_away, any_rule_one_day_away,
	will_be_disposed_tomorrow, pred_prob_disposal,

	created_at
)
SELECT
	id, type, notice_id, stock_no, notice_dt_ts, law_src,
	coming_punish_id, coming_punish_interval_days, days_to_next_notice,
	notice_law_count, same_law_repeat_3t, law1_consecutive_days,
	law1to8_count_10t, law1to8_count_30t, law1to8_consecutive_days,
	disposal_period_day_index, disposal_period, disposal_times_30t,

	NULL AS rule1_one_day_away,
	NULL AS rule2_one_day_away,
	NULL AS rule3_one_day_away,
	NULL AS rule4_one_day_away,
	NULL AS any_rule_one_day_away,

	NULL AS will_be_disposed_tomorrow,
	NULL AS pred_prob_disposal,

	created_at
FROM notice_behavior_feature;

-- ③ 刪舊表
DROP TABLE notice_behavior_feature;

-- ④ 新表改名
ALTER TABLE notice_behavior_feature_new
RENAME TO notice_behavior_feature;

-----------
DROP VIEW IF EXISTS v_law1_feature_ana2;

CREATE VIEW v_law1_feature_ana2 AS
WITH base_twse AS (
    SELECT
        target_id,
        feature_key,
        feature_value,
        threshold_value,
        raw_text
    FROM law_feature_base
    WHERE target_table = 'twse_announcement_notice'
      AND law_src = '第一款'
),
base_tpex AS (
    SELECT
        target_id,
        feature_key,
        feature_value,
        threshold_value,
        raw_text
    FROM law_feature_base
    WHERE target_table = 'tpex_bulletin_attention'
      AND law_src = '第一款'
),
base_union AS (
    SELECT * FROM base_twse
    UNION ALL
    SELECT * FROM base_tpex
),
acc_return AS (
    SELECT
        target_id,
        feature_value   AS acc_return_pct,
        threshold_value AS a_threshold
    FROM base_union
    WHERE feature_key = 'acc_return_pct'
),
price_diff AS (
    SELECT
        target_id,
        feature_value   AS price_diff,
        threshold_value AS p_threshold
    FROM base_union
    WHERE feature_key = 'price_diff'
),
raw_text AS (
    SELECT
        target_id,
        raw_text AS notice_raw_content
    FROM base_union
    GROUP BY target_id
)

SELECT
    F.id AS feature_id,
    F.type,
    F.notice_id,
    F.stock_no,
    strftime('%Y-%m-%d', F.notice_dt_ts, 'unixepoch', 'localtime') AS notice_date,

    -- law_src 用 F.law_src
    F.law_src,

    F.will_be_disposed_tomorrow,

    -- 你要求多顯示的兩欄
    F.any_rule_one_day_away,
    F.rule_one_day_away_count,

    -- feature 欄位
    A.acc_return_pct,
    A.a_threshold,
    P.price_diff,
    P.p_threshold,
    R.notice_raw_content

FROM notice_behavior_feature F
LEFT JOIN acc_return A
    ON A.target_id = F.notice_id
LEFT JOIN price_diff P
    ON P.target_id = F.notice_id
LEFT JOIN raw_text R
    ON R.target_id = F.notice_id

WHERE
    F.any_rule_one_day_away = 1
    AND F.rule_one_day_away_count = 1
    AND F.law_src = '第一款'   -- 🔴 同樣用 F.law_src 過濾

ORDER BY
	F.type,
    F.stock_no,
    F.notice_dt_ts DESC;
</sql><sql name="View">SELECT strftime('%Y-%m-%d', N.notice_dt_ts, 'unixepoch', 'localtime') AS notice_date,N.* 
	FROM notice_behavior_feature N
	WHERE any_rule_one_day_away = 1
	ORDER BY stock_no, notice_date DESC;

SELECT 
	N.type, N.stock_no,
	strftime('%Y-%m-%d', N.notice_dt_ts, 'unixepoch', 'localtime') AS notice_date,
	CASE
        WHEN N.type = 'twse' THEN WP.公布日期
        WHEN N.type = 'tpex' THEN PP.公布日期
        ELSE NULL
    END AS 處置發布日期,
	CASE
        WHEN N.type = 'twse' THEN WP.處置起迄時間
        WHEN N.type = 'tpex' THEN PP.處置起訖時間
        ELSE NULL
    END AS 處置起迄,
	N.notice_dt_ts,
	CASE
        WHEN N.type = 'twse' THEN WP.公布日期_ts
        WHEN N.type = 'tpex' THEN PP.公布日期_ts
        ELSE NULL
    END AS 處置發布日期_ts,
	N.*
FROM notice_behavior_feature N
	LEFT JOIN twse_announcement_punish WP ON WP.id = N.coming_punish_id AND N.type = 'twse'
	LEFT JOIN tpex_bulletin_disposal PP ON PP.id = N.coming_punish_id AND N.type = 'tpex'
WHERE any_rule_one_day_away = 1
	AND N.law_src = '第一款'
ORDER BY N.stock_no, notice_date DESC;

SELECT * FROM notice_behavior_feature WHERE pred_prob_disposal IS NOT NULL;</sql><sql name="tmp">CREATE TABLE &quot;fm_stock_span&quot; (
	&quot;target_table&quot;	TEXT NOT NULL,
	&quot;stock_id&quot;	TEXT NOT NULL,
	&quot;start_date&quot;	TEXT NOT NULL,
	&quot;end_date&quot;	TEXT NOT NULL,
	&quot;updated_at&quot;	INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
	PRIMARY KEY(&quot;target_table&quot;,&quot;stock_id&quot;)
);

CREATE TABLE &quot;fm_taiwan_stock_daily&quot; (
	&quot;id&quot;	INTEGER,
	&quot;date&quot;	TEXT NOT NULL,
	&quot;stock_id&quot;	TEXT NOT NULL,
	&quot;Trading_Volume&quot;	INTEGER NOT NULL,
	&quot;Trading_money&quot;	INTEGER NOT NULL,
	&quot;open&quot;	REAL NOT NULL,
	&quot;max&quot;	REAL NOT NULL,
	&quot;min&quot;	REAL NOT NULL,
	&quot;close&quot;	REAL NOT NULL,
	&quot;spread&quot;	REAL NOT NULL,
	&quot;Trading_turnover&quot;	INTEGER NOT NULL,
	&quot;created_at&quot;	INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
	&quot;updated_at&quot;	INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
	UNIQUE(&quot;date&quot;,&quot;stock_id&quot;),
	PRIMARY KEY(&quot;id&quot; AUTOINCREMENT)
);</sql><sql name="編輯檢視表 v_law1_feature_ana">DROP VIEW IF EXISTS v_law1_feature_ana;

CREATE VIEW v_law1_feature_ana AS
WITH base_union AS (
    SELECT
        'twse' AS src_type,
        target_id,
        feature_key,
        feature_value,
        threshold_value,
        raw_text
    FROM law_feature_base
    WHERE target_table = 'twse_announcement_notice'
      AND law_src = '第一款'

    UNION ALL

    SELECT
        'tpex' AS src_type,
        target_id,
        feature_key,
        feature_value,
        threshold_value,
        raw_text
    FROM law_feature_base
    WHERE target_table = 'tpex_bulletin_attention'
      AND law_src = '第一款'
),
acc_return AS (
    SELECT
        src_type,
        target_id,
        feature_value AS acc_return_pct,
        threshold_value AS a_threshold
    FROM base_union
    WHERE feature_key = 'acc_return_pct'
),
price_diff AS (
    SELECT
        src_type,
        target_id,
        feature_value AS price_diff,
        threshold_value AS p_threshold
    FROM base_union
    WHERE feature_key = 'price_diff'
),
raw_text AS (
    SELECT
        src_type,
        target_id,
        raw_text AS notice_raw_content
    FROM base_union
    GROUP BY src_type, target_id
),

twse_src AS (
    SELECT
        id,
        &quot;累計次數&quot; AS acc_notice_cnt,
        &quot;收盤價&quot;   AS src_close_price,
        &quot;本益比&quot;   AS src_pe_ratio
    FROM twse_announcement_notice
),

tpex_src AS (
    SELECT
        id,
        &quot;累計&quot;     AS acc_notice_cnt,
        &quot;收盤價&quot;   AS src_close_price,
        &quot;本益比&quot;   AS src_pe_ratio
    FROM tpex_bulletin_attention
)

SELECT
    F.id AS feature_id,
    F.type,
    F.notice_id,
    F.stock_no,
    strftime('%Y-%m-%d', F.notice_dt_ts, 'unixepoch', 'localtime') AS notice_date,
    F.law_src,

    -- ★★★★★ 新增 pred_prob_disposal（放在 will_be… 前）★★★★★
    F.pred_prob_disposal,

    F.will_be_disposed_tomorrow,

    -- 新增的三欄位
    CASE WHEN F.type = 'twse' THEN T.acc_notice_cnt
         WHEN F.type = 'tpex' THEN X.acc_notice_cnt
    END AS acc_notice_cnt,

    CASE WHEN F.type = 'twse' THEN T.src_close_price
         WHEN F.type = 'tpex' THEN X.src_close_price
    END AS src_close_price,

    CASE WHEN F.type = 'twse' THEN T.src_pe_ratio
         WHEN F.type = 'tpex' THEN X.src_pe_ratio
    END AS src_pe_ratio,

    -- 其他欄位
    A.acc_return_pct,
    A.a_threshold,
    P.price_diff,
    P.p_threshold,
    R.notice_raw_content

FROM notice_behavior_feature F
LEFT JOIN acc_return A
       ON A.target_id = F.notice_id AND A.src_type = F.type
LEFT JOIN price_diff P
       ON P.target_id = F.notice_id AND P.src_type = F.type
LEFT JOIN raw_text R
       ON R.target_id = F.notice_id AND R.src_type = F.type
LEFT JOIN twse_src T
       ON F.type = 'twse' AND T.id = F.notice_id
LEFT JOIN tpex_src X
       ON F.type = 'tpex' AND X.id = F.notice_id

WHERE
    F.any_rule_one_day_away = 1
    AND F.rule_one_day_away_count = 1
    AND F.law_src = '第一款'

ORDER BY
    F.type, F.stock_no, F.notice_dt_ts DESC;
</sql><sql name="編輯檢視表 v_law1_feature_ana">DROP VIEW IF EXISTS &quot;main&quot;.&quot;v_law1_feature_ana&quot;;
CREATE VIEW v_law1_feature_ana AS
WITH base_union AS (
