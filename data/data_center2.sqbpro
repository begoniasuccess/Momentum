 index="5" value="689"/><column index="6" value="78"/><column index="7" value="54"/><column index="8" value="54"/><column index="9" value="156"/><column index="10" value="85"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="twse_announcement_punish" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="39"/><column index="2" value="78"/><column index="3" value="57"/><column index="4" value="124"/><column index="5" value="33"/><column index="6" value="176"/><column index="7" value="161"/><column index="8" value="85"/><column index="9" value="1905"/><column index="10" value="300"/><column index="11" value="156"/><column index="12" value="85"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="v_attention_notice" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="1" mode="0"/></sort><column_widths><column index="1" value="39"/><column index="2" value="101"/><column index="3" value="57"/><column index="4" value="119"/><column index="5" value="33"/><column index="6" value="54"/><column index="7" value="54"/><column index="8" value="3754"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="History">DROP VIEW IF EXISTS &quot;main&quot;.&quot;v_attention_notice&quot;;
CREATE VIEW v_attention_notice AS
SELECT
	'twse' AS &quot;來源&quot;,
	strftime('%Y/%m/%d', datetime(日期_ts, 'unixepoch'))  AS &quot;公告日期&quot;,
    &quot;證券代號&quot;,
    &quot;證券名稱&quot;,
    &quot;累計次數&quot; AS &quot;累計&quot;,        
    &quot;收盤價&quot;,
    &quot;本益比&quot;,
	&quot;注意交易資訊&quot;
FROM twse_announcement_notice

UNION ALL

SELECT
	'tpex' AS &quot;來源&quot;,
	strftime('%Y/%m/%d', datetime(公告日期_ts, 'unixepoch'))  AS &quot;公告日期&quot;,
    &quot;證券代號&quot;,
    &quot;證券名稱&quot;,
    &quot;累計&quot;,       
    &quot;收盤價&quot;,
    &quot;本益比&quot;,
	&quot;注意交易資訊&quot;
FROM tpex_bulletin_attention

ALTER TABLE twse_announcement_punish ADD COLUMN law_src TEXT;
ALTER TABLE tpex_bulletin_disposal ADD COLUMN law_src TEXT;</sql><sql name="View*">--SELECT * FROM data_source WHERE name LIKE '%注意%' OR name LIKE '%處置%' ORDER by name;
--SELECT * FROM twse_announcement_notice WHERE law_src IS NULL or law_src = '' ORDER BY 日期_ts DESC LIMIT 200 OFFSET 0;

