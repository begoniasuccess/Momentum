    strftime('%Y-%m-%d', F.notice_dt_ts, 'unixepoch', 'localtime') AS notice_date,
    F.law_src,

    -- ★★★★★ 新增 pred_prob_disposal（放在 will_be… 前）★★★★★
    F.pred_prob_disposal,

    F.will_be_disposed_tomorrow,

    -- 新增的三欄位
    CASE WHEN F.type = 'twse' THEN T.acc_notice_cnt
         WHEN F.type = 'tpex' THEN X.acc_notice_cnt
    END AS acc_notice_cnt,

    CASE WHEN F.type = 'twse' THEN T.src_close_price
         WHEN F.type = 'tpex' THEN X.src_close_price
    END AS src_close_price,

    CASE WHEN F.type = 'twse' THEN T.src_pe_ratio
         WHEN F.type = 'tpex' THEN X.src_pe_ratio
    END AS src_pe_ratio,

    -- 其他欄位
    A.acc_return_pct,
    A.a_threshold,
    P.price_diff,
    P.p_threshold,
    R.notice_raw_content

FROM notice_behavior_feature F
LEFT JOIN acc_return A
       ON A.target_id = F.notice_id AND A.src_type = F.type
LEFT JOIN price_diff P
       ON P.target_id = F.notice_id AND P.src_type = F.type
LEFT JOIN raw_text R
       ON R.target_id = F.notice_id AND R.src_type = F.type
LEFT JOIN twse_src T
       ON F.type = 'twse' AND T.id = F.notice_id
LEFT JOIN tpex_src X
       ON F.type = 'tpex' AND X.id = F.notice_id

WHERE
    F.any_rule_one_day_away = 1
    AND F.rule_one_day_away_count = 1
    AND F.law_src = '第一款'

ORDER BY
    F.type, F.stock_no, F.notice_dt_ts DESC</sql><sql name="SQL 15">DROP VIEW IF EXISTS v_law1_feature_ana;

CREATE VIEW v_law1_feature_ana AS
WITH base_union AS (
    SELECT
        'twse' AS src_type,
        target_id,
        feature_key,
        feature_value,
        threshold_value,
        raw_text
    FROM law_feature_base
    WHERE target_table = 'twse_announcement_notice'
      AND law_src = '第一款'

    UNION ALL

    SELECT
        'tpex' AS src_type,
        target_id,
        feature_key,
        feature_value,
        threshold_value,
        raw_text
    FROM law_feature_base
    WHERE target_table = 'tpex_bulletin_attention'
      AND law_src = '第一款'
),
acc_return AS (
    SELECT
        src_type,
        target_id,
        feature_value AS acc_return_pct,
        threshold_value AS a_threshold
    FROM base_union
    WHERE feature_key = 'acc_return_pct'
),
price_diff AS (
    SELECT
        src_type,
        target_id,
        feature_value AS price_diff,
        threshold_value AS p_threshold
    FROM base_union
    WHERE feature_key = 'price_diff'
),
raw_text AS (
    SELECT
        src_type,
        target_id,
        raw_text AS notice_raw_content
    FROM base_union
    GROUP BY src_type, target_id
),

twse_src AS (
    SELECT
        id,
        &quot;累計次數&quot; AS acc_notice_cnt,
        &quot;收盤價&quot;   AS src_close_price,
        &quot;本益比&quot;   AS src_pe_ratio
    FROM twse_announcement_notice
),

tpex_src AS (
    SELECT
        id,
        &quot;累計&quot;     AS acc_notice_cnt,
        &quot;收盤價&quot;   AS src_close_price,
        &quot;本益比&quot;   AS src_pe_ratio
    FROM tpex_bulletin_attention
),

-- 先把原本 view 的主體算成一個 CTE
law1_base AS (
    SELECT
        F.id AS feature_id,
        F.type,
        F.notice_id,
        F.stock_no,
        strftime('%Y-%m-%d', F.notice_dt_ts, 'unixepoch', 'localtime') AS notice_date,
        F.law_src,

        -- 預測機率
        F.pred_prob_disposal,

        F.will_be_disposed_tomorrow,

        -- 新增的三欄位（沿用你原本寫法）
        CASE WHEN F.type = 'twse' THEN T.acc_notice_cnt
             WHEN F.type = 'tpex' THEN X.acc_notice_cnt
        END AS acc_notice_cnt,

        CASE WHEN F.type = 'twse' THEN T.src_close_price
             WHEN F.type = 'tpex' THEN X.src_close_price
        END AS src_close_price,

        CASE WHEN F.type = 'twse' THEN T.src_pe_ratio
             WHEN F.type = 'tpex' THEN X.src_pe_ratio
        END AS src_pe_ratio,

        -- 其他欄位
        A.acc_return_pct,
        A.a_threshold,
        P.price_diff,
        P.p_threshold,
        R.notice_raw_content

    FROM notice_behavior_feature F
    LEFT JOIN acc_return A
           ON A.target_id = F.notice_id AND A.src_type = F.type
    LEFT JOIN price_diff P
           ON P.target_id = F.notice_id AND P.src_type = F.type
    LEFT JOIN raw_text R
           ON R.target_id = F.notice_id AND R.src_type = F.type
    LEFT JOIN twse_src T
           ON F.type = 'twse' AND T.id = F.notice_id
    LEFT JOIN tpex_src X
           ON F.type = 'tpex' AND X.id = F.notice_id

    WHERE
        F.any_rule_one_day_away = 1
        AND F.rule_one_day_away_count = 1
        AND F.law_src = '第一款'
)

-- 最外層：接上 T+1 價格欄位
SELECT
    B.*,

    D.open  AS T1_open,
    D.close AS T1_close,
    D.min   AS T1_min,
    D.max   AS T1_max

FROM law1_base B
LEFT JOIN fm_taiwan_stock_daily D
  ON D.stock_id = B.stock_no
 AND D.date = (
        SELECT MIN(d2.date)
        FROM fm_taiwan_stock_daily d2
        WHERE d2.stock_id = B.stock_no
          AND d2.date &gt; B.notice_date
     )

ORDER BY
    B.type,
    B.stock_no,
    B.notice_date DESC;




</sql><sql name="SQL 16">DROP VIEW IF EXISTS v_law1_feature_ana_t1_long;

CREATE VIEW v_law1_feature_ana_t1_long AS
SELECT
    v.*,

    -- T+1 漲停價（暫不考慮tick規則，可之後再補）
    v.src_close_price * 1.1 AS T1_limit_up_price,

    -- 賣出價格：若盤中漲停&gt;=漲停價則以漲停價賣
    CASE
        WHEN v.T1_max IS NOT NULL
         AND v.src_close_price IS NOT NULL
         AND v.T1_max &gt;= v.src_close_price * 1.1
        THEN v.src_close_price * 1.1
        ELSE v.T1_close
    END AS T1_sell_price,

    -- 多單報酬 (long return)
    CASE
        WHEN v.T1_open IS NOT NULL
         AND v.T1_open != 0
         AND (
               v.T1_close IS NOT NULL
            OR (v.T1_max IS NOT NULL AND v.src_close_price IS NOT NULL)
         )
        THEN
            (CASE
                WHEN v.T1_max IS NOT NULL
                 AND v.src_close_price IS NOT NULL
                 AND v.T1_max &gt;= v.src_close_price * 1.1
                THEN v.src_close_price * 1.1
                ELSE v.T1_close
            END - v.T1_open) / v.T1_open
        ELSE NULL
    END AS T1_long_ret

FROM v_law1_feature_ana v;
</sql><sql name="SQL 17*">------ T-1做空策略
