</sql><sql name="History">DROP VIEW IF EXISTS &quot;main&quot;.&quot;v_attention_notice&quot;;
CREATE VIEW v_attention_notice AS
SELECT
	'twse' AS &quot;來源&quot;,
	strftime('%Y/%m/%d', datetime(日期_ts, 'unixepoch'))  AS &quot;公告日期&quot;,
    &quot;證券代號&quot;,
    &quot;證券名稱&quot;,
    &quot;累計次數&quot; AS &quot;累計&quot;,        
    &quot;收盤價&quot;,
    &quot;本益比&quot;,
	&quot;注意交易資訊&quot;
FROM twse_announcement_notice

UNION ALL

SELECT
	'tpex' AS &quot;來源&quot;,
	strftime('%Y/%m/%d', datetime(公告日期_ts, 'unixepoch'))  AS &quot;公告日期&quot;,
    &quot;證券代號&quot;,
    &quot;證券名稱&quot;,
    &quot;累計&quot;,       
    &quot;收盤價&quot;,
    &quot;本益比&quot;,
	&quot;注意交易資訊&quot;
FROM tpex_bulletin_attention

ALTER TABLE twse_announcement_punish ADD COLUMN law_src TEXT;
ALTER TABLE tpex_bulletin_disposal ADD COLUMN law_src TEXT;

ALTER TABLE twse_announcement_punish ADD COLUMN last_notice INTEGER;
ALTER TABLE tpex_bulletin_disposal ADD COLUMN last_notice INTEGER;

CREATE TABLE IF NOT EXISTS relation_punish_notice (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    type TEXT NOT NULL,
    punish_id INTEGER NOT NULL,
    notice_id INTEGER NOT NULL,
    created_at TIMESTAMP DEFAULT (datetime('now', 'localtime')),
    UNIQUE (punish_id, notice_id, type)
);

CREATE TABLE addition_info (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    target_table TEXT NOT NULL,
    target_id INTEGER NOT NULL,
    col_name TEXT NOT NULL,
    col_val TEXT,
    memo TEXT,
    created_at TIMESTAMP DEFAULT (strftime('%Y-%m-%d %H:%M:%f', 'now')),
    UNIQUE(target_table, target_id, col_name)
);


SELECT * FROM twse_announcement_punish 
	WHERE 證券代號 = (SELECT 證券代號 FROM twse_announcement_punish WHERE id+0 = 808)
	AND 公布日期_ts &lt;= (SELECT 公布日期_ts FROM twse_announcement_punish WHERE id+0 = 808)
	ORDER BY 公布日期_ts DESC;
	
SELECT * FROM twse_announcement_notice 
	WHERE 證券代號 = (SELECT 證券代號 FROM twse_announcement_punish WHERE id+0 = 808)
	AND 日期_ts &lt;= (SELECT 公布日期_ts FROM twse_announcement_punish WHERE id+0 = 808)
	ORDER BY 日期_ts DESC LIMIT 5;

SELECT R.* FROM relation_punish_notice R;

SELECT R.id, R.type, 
		R.punish_id, 
		P.公布日期 AS 處置日期, N.日期 AS 公告日期, P.證券代號, P.證券名稱, P.累計 AS 處置累計, P.處置起迄時間, P.處置措施,
		P.last_notice, P.notice_cnt,
		R.notice_id, 
		N.累計次數 AS 注意累計, N.law_src AS 公告法源, N.注意交易資訊,
		P.處置內容
	FROM relation_punish_notice R
	LEFT JOIN twse_announcement_punish P ON R.punish_id+0 = P.id+0 AND R.type = 'twse'
	LEFT JOIN twse_announcement_notice N ON R.notice_id+0 = N.id+0 AND R.type = 'twse'
	WHERE R.type = 'twse'
	ORDER BY 處置日期 DESC, punish_id, 公告日期 DESC;
	
SELECT R.id, R.type, 
		R.punish_id, 
		P.公布日期 AS 處置日期, P.證券代號, N.證券名稱, P.累計 AS 處置累計, P.處置起迄時間, P.處置措施,
		P.last_notice, P.notice_cnt,
		R.notice_id, 
		N.日期 AS 公告日期, N.累計次數 AS 注意累計, N.law_src AS 公告法源, N.注意交易資訊,
		P.處置內容
	FROM relation_punish_notice R
	LEFT JOIN tpex_bulletin_disposal P ON R.punish_id+0 = P.id+0 AND R.type = 'tpex'
	LEFT JOIN tpex_bulletin_attention N ON R.notice_id+0 = N.id+0 AND R.type = 'tpex'
	WHERE R.type = 'tpex'
	ORDER BY 處置日期 DESC, punish_id, 公告日期 DESC;
SELECT * FROM twse_announcement_notice 
	WHERE 證券代號 = (SELECT 證券代號 FROM twse_announcement_punish WHERE id+0 = 1182) 
	AND 日期_ts &lt;= (SELECT 公布日期_ts FROM twse_announcement_punish WHERE id+0 = 1182) 
	ORDER BY 日期_ts DESC;

SELECT * FROM twse_announcement_punish
    WHERE last_notice IS NULL OR notice_cnt IS NULL;
	
SELECT * FROM tpex_bulletin_disposal
    WHERE last_notice IS NULL OR notice_cnt IS NULL;

SELECT * FROM twse_announcement_notice
	WHERE 證券代號 = '8021' AND 日期 LIKE '114.08.%'
	ORDER BY 日期 DESC;
	
SELECT * FROM twse_announcement_punish WHERE id+0 = 206;
SELECT * FROM twse_announcement_notice 
	WHERE 證券代號 = (SELECT 證券代號 FROM twse_announcement_punish WHERE id+0 = 206) 
	ORDER BY 日期_ts DESC;
	

SELECT * FROM tpex_bulletin_disposal WHERE id+0 = 206;
SELECT * FROM tpex_bulletin_attention 
	WHERE 證券代號 = (SELECT 證券代號 FROM tpex_bulletin_disposal WHERE id+0 = 206) 
	ORDER BY 公告日期_ts DESC;
	
--UPDATE tpex_bulletin_disposal SET 證券代號 = '8299' WHERE 證券代號 = '82992';
SELECT * FROM tpex_bulletin_disposal 
	--WHERE 證券名稱 LIKE '群聯%'
	--WHERE 處置原因 LIKE '轉%'
	WHERE LENGTH(證券代號) &gt; 4
	ORDER BY 公布日期;


-- 4️⃣ 刪掉舊表
DROP TABLE addition_info;

-- 2️⃣ 建立新表（加上 UNIQUE 條件）
CREATE TABLE addition_info (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tag TEXT,
    target_table TEXT,
    target_id INTEGER,
    col_name TEXT,
    col_val TEXT,
    val_type TEXT,
	memo	TEXT,
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(tag, target_table, target_id, col_name, col_val, val_type)
);



</sql><sql name="View">SELECT 
	R.id, R.type, R.notice_id, R.punish_id, P.證券代號, N.證券名稱, strftime('%Y/%m/%d', N.日期_ts, 'unixepoch') AS 注意日期,
	date(P.公布日期_ts, 'unixepoch') AS 處置日期,-- A.col_val AS 處置原因,
	 N.law_src AS 注意公告法源, N.注意交易資訊 AS 注意公告資訊,
	'' AS 注意公告_近日多次_n個營業日, '' AS 注意公告_近日多次_次數,
	'' AS 注意公告_近日曾達_n個營業日, '' AS 注意公告_近日曾達_條項款,
	'' AS 注意公告_連續觸發_天數, '' AS 注意公告_連續觸發_條項款,
	'' AS 發布處置_最近n日內, '' AS 撮合頻率_n分一次
FROM relation_punish_notice R
	LEFT JOIN twse_announcement_punish P ON (P.id = R.punish_id AND R.type = 'twse') 
	LEFT JOIN twse_announcement_notice N ON (N.id = R.notice_id AND R.type = 'twse')
	LEFT JOIN addition_info A ON A.target_table = 'twse_announcement_punish' AND A.target_id = P.id AND col_name = '處置原因'
	WHERE R.type = 'twse'
UNION ALL
SELECT 
	R.id, R.type, R.notice_id, R.punish_id, P.證券代號, N.證券名稱, strftime('%Y/%m/%d', N.公告日期_ts, 'unixepoch') AS 注意日期,
	date(P.公布日期_ts, 'unixepoch') AS 處置日期,-- P.處置內容 AS 處置原因, 
	N.law_src AS 注意公告法源, N.注意交易資訊 AS 注意公告資訊,
	A.col_val AS 注意公告_近日多次_n個營業日, A2.col_val AS 注意公告_近日多次_次數,
	A3.col_val AS 注意公告_近日曾達_n個營業日, A4.col_val AS 注意公告_近日曾達_條項款,
	A5.col_val AS 注意公告_連續觸發_天數, A6.col_val AS 注意公告_連續觸發_條項款,
	A7.col_val AS 發布處置_最近n日內, A8.col_val AS 撮合頻率_n分一次
FROM relation_punish_notice R
	LEFT JOIN tpex_bulletin_disposal P ON (P.id = R.punish_id AND R.type = 'tpex')
	LEFT JOIN tpex_bulletin_attention N ON (N.id = R.notice_id AND R.type = 'tpex')
	LEFT JOIN addition_info A ON A.target_table = 'tpex_bulletin_disposal' 
		AND A.target_id = P.id AND A.col_name = '注意公告_近日多次_n個營業日'
	LEFT JOIN addition_info A2 ON A2.target_table = 'tpex_bulletin_disposal' 
		AND A2.target_id = P.id AND A2.col_name = '注意公告_近日多次_次數'
	LEFT JOIN addition_info A3 ON A3.target_table = 'tpex_bulletin_disposal' 
		AND A3.target_id = P.id AND A3.col_name = '注意公告_近日曾達_n個營業日'
	LEFT JOIN addition_info A4 ON A4.target_table = 'tpex_bulletin_disposal' 
		AND A4.target_id = P.id AND A4.col_name = '注意公告_近日曾達_條項款'
	LEFT JOIN addition_info A5 ON A5.target_table = 'tpex_bulletin_disposal' 
		AND A5.target_id = P.id AND A5.col_name = '注意公告_連續觸發_天數'
	LEFT JOIN addition_info A6 ON A6.target_table = 'tpex_bulletin_disposal' 
		AND A6.target_id = P.id AND A6.col_name = '注意公告_連續觸發_條項款'
	LEFT JOIN addition_info A7 ON A7.target_table = 'tpex_bulletin_disposal' 
		AND A7.target_id = P.id AND A7.col_name = '發布處置_最近n日內'
	LEFT JOIN addition_info A8 ON A8.target_table = 'tpex_bulletin_disposal' 
		AND A8.target_id = P.id AND A8.col_name = '撮合頻率_n分一次'
	WHERE R.type = 'tpex' AND P.處置內容 NOT LIKE '%公司債%'
	ORDER BY 8, 5, 7 DESC;

SELECT COUNT(*) FROM relation_punish_notice WHERE </sql><sql name="Execute">CREATE VIEW v_stock_punish AS
SELECT 
    'twse' AS type,
    公布日期,
    證券代號,
    證券名稱,
    累計,
    處置條件,
    處置起迄時間 AS 處置起訖時間,
    處置措施,
    處置內容,
    備註,
    created_at,
    公布日期_ts,
    law_src,
    last_notice,
    notice_cnt,
    notice_dt
FROM twse_announcement_punish

UNION ALL

SELECT 
    'tpex' AS type,
    公布日期,
    證券代號,
    證券名稱,
    累計,
    處置原因 AS 處置條件,
    處置起訖時間,
    NULL AS 處置措施,
    處置內容,
    memo AS 備註,
    created_at,
    公布日期_ts,
    law_src,
    last_notice,
    notice_cnt,
    notice_dt
FROM tpex_bulletin_disposal;
</sql><sql name="tmp">
SELECT P.notice_dt, (N.證券名稱 || '-' || N.公告日期) AS notice_info, P.* FROM tpex_bulletin_disposal P
	LEFT JOIN tpex_bulletin_attention N ON P.last_notice = N.id
	WHERE last_notice IS NOT NULL AND last_notice &lt;&gt; ''
	ORDER BY 公布日期 DESC;

</sql><current_tab id="4"/></tab_sql></sqlb_project>
